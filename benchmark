#!/usr/bin/env bash
# Runs the full cMVBT experiment suite (TPC-C, CH-benCHmark/"TPC-H", HTAP,
# YCSB A-F, each with GC on and off) with zero arguments:
#
#   ./benchmark
#
# Optional args are forwarded as-is to the `benchmark` subcommand (see
# `src/mv_bench/suite.rs`): an output-root directory, and/or `quick` for a
# fast smoke-test scale, e.g.:
#
#   ./benchmark benchmark_results quick
#
set -euo pipefail
cd "$(dirname "$0")"

cargo build --release
exec ./target/release/cMVBT benchmark "$@"

<+>[package]\nname = \"cMVBT\"\nversion = \"0.0.125\"\nedition = \"2024\"\nauthors = [\"Amir Tonta <amir.tonta@mathematik.uni-marburg.de>\"]\ndescription = \"cMVBT Research Implementation\"\nrepository = \"https://github.com/umr-dbs/cMVBT-OSIC\"\n# `tests/` holds unit-test files pulled into the bin crate via `#[path]` mods\n# (this crate has no `[lib]` target, so they can't be real integration\n# tests) alongside genuine standalone integration tests. Autodiscovery would\n# try to compile every one of those unit-test files as its own integration-\n# test crate too, which fails (they use `crate::...` internals that don't\n# exist outside the bin). Disabled in favor of explicit `[[test]]` entries\n# below for the files that really are standalone.\nautotests = false\n\n[profile.dev]\noverflow-checks = false\n\n[profile.release]\n#debug = \"line-tables-only\"\n#overflow-checks = false\nopt-level = 3            # maximum LLVM optimizations\nlto = \"fat\"              # full link-time optimization (cross-crate)\ncodegen-units = 1        # better optimization, slower compile\npanic = \"abort\"          # removes unwinding overhead\nstrip = true             # smaller binary (optional)\ndebug = 0                # no debug info\nincremental = false      # better optimization consistency\n\n[profile.profiling]\ninherits = \"release\"\ndebug = true\nstrip = false\n\n[build]\nrustflags = [\"-C\", \"target-cpu=native\"]\n\n[features]\nhardware-lock-elision = []\n# Gates the libmdbx-backed comparison engine (src/mv_bench/mdbx_ycsb.rs/mdbx_tpcc.rs) -\n# optional since it's a second, independent storage backend (path-copying/copy-on-write\n# B+Tree via libmdbx) alongside this crate's own MVBTree, not something every build needs.\nmdbx-backend = [\"dep:libmdbx\"]\n# Gates `src/mv_viz` (structural tree/root* dump -> JSON for the standalone\n# `tools/tree_visualizer.html` viewer) - a debug/inspection tool, not\n# anything the benchmark/paper path needs, so its `serde`/`serde_json` deps\n# stay out of the default build.\ntree-viz = [\"dep:serde\", \"dep:serde_json\"]\n\n#[lib]\n#name = \"cmvbt\"\n#path = \"src/lib.rs\"\n#crate-type = [\"cdylib\"]\n# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html\n\n[dependencies]\nCCBPlusTree = { git = \"https://github.com/umr-dbs/CC-BPlusTree.git\", version = \"0.0.122\" }\ncrossbeam-channel = \"0.5.16\"\ncrossbeam-skiplist = \"0.1.3\"\ncrossbeam-utils = \"0.8.22\"\nchrono = \"0.4.45\"\nrand_distr = \"0.6.0\"\nrand = \"0.10.2\"\nfastrand = \"2.3.0\"\nitertools = \"0.15.0\"\nparking_lot = { version = \"0.12.5\", features = [\"hardware-lock-elision\", \"arc_lock\"] }\narc-swap = \"1.9.2\"\nsmallvec = \"1.15.2\"\nlibmdbx = { version = \"0.6.6\", optional = true }\nserde = { version = \"1.0\", features = [\"derive\"], optional = true }\nserde_json = { version = \"1.0\", optional = true }\n[target.'cfg(target_os = \"linux\")'.dependencies]\nlibc = \"0.2.186\"\nnum_cpus = \"1.17\"\njemallocator = \"0.5.4\"\njemalloc-ctl = \"0.5.4\"\ntriomphe = \"0.1.16\"\n\n[dev-dependencies]\nloom = \"0.7\"\n\n[[test]]\nname = \"loom_registration_ordering\"\npath = \"tests/loom_registration_ordering.rs\"\n\n[[test]]\nname = \"loom_read_validation\"\npath = \"tests/loom_read_validation.rs\"

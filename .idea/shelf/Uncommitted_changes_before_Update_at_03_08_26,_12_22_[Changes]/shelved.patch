diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml	(revision b29d347523d1cde54f02b02e2e625852d6de0c82)
+++ b/Cargo.toml	(date 1785687955682)
@@ -33,6 +33,19 @@
 debug = true
 strip = false
 
+# Same optimization level as release, but without the two settings that make
+# a fresh build/rebuild-after-profile-tweak painfully slow (fat LTO + a
+# single codegen unit) - for iterating on release-like timing behavior
+# (races that don't reproduce in `dev`'s unoptimized build) without paying
+# release's own multi-minute rebuild cost every time. Never use this
+# profile's numbers for reported benchmark results - only `release` itself
+# is representative of the real, shipped optimization level.
+[profile.release-fast]
+inherits = "release"
+lto = false
+codegen-units = 16
+incremental = true
+
 [build]
 rustflags = ["-C", "target-cpu=native"]
 

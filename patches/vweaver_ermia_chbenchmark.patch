+// ---------------------------------------------------------------------
+// CH-benCHmark Q1/Q6 (see mv_bench::tpch_queries::q1/q6 in the sibling
+// cMVBT-OSIC harness for the reference implementation every engine there
+// ports) - run from a dedicated thread (tpcc_bench_runner::StartHtapThread,
+// below) rather than mixed into the normal per-transaction weighted workload
+// the way Query2/txn_query2 above is: this matches the "N OLTP threads + 1
+// always-on dedicated OLAP thread" convention every other engine in that
+// harness already uses for htap_q1/htap_q6, so OLTP thread counts stay
+// directly comparable to a plain "tpcc" run at the same worker_threads.
+//
+// ORDER_LINE is one table PER WAREHOUSE here (see TPCC_TABLE_LIST/
+// tbl_order_line), unlike the sibling harness's single-tree-per-table
+// engines - "one full ORDER_LINE table scan" is therefore a loop over every
+// warehouse's own table, all under one transaction snapshot (the same
+// multi-warehouse-loop-under-one-txn shape txn_query2() above already uses).
+// `scoped_str_arena` constructed fresh per warehouse resets the arena on
+// each iteration (see its destructor) so a whole-database scan can't
+// overrun str_arena's fixed 128MB reservation the way accumulating every
+// warehouse into one still-open scope would.
+//
+// ol_delivery_d == 0 means "not delivered yet" (see NewOrder/Delivery/the
+// loader, all of which use exactly this sentinel). GetCurrentTimeMillis()
+// (used to stamp it) is a per-thread monotonic counter here, not a real
+// wall-clock (see its own comment above) - so unlike the sibling harness's
+// engines, there is no meaningful absolute date range to filter on;
+// delivered_before/date_lo/date_hi are always wide open (see
+// tpcc_bench_runner::HtapThreadMain).
+struct ch_q1_group {
+  uint64_t count = 0;
+  uint64_t sum_qty = 0;
+  double sum_amount = 0.0;
+};
+
+// Streaming aggregation, NOT tpcc_table_scanner's own "buffer every (key,
+// value) pair into the arena, aggregate after" style (the style
+// txn_stock_level/txn_query2 above use) - those only ever scan a few
+// hundred/thousand rows at most (one district's last-20-orders, or a <100-row
+// dimension table). ORDER_LINE across a whole warehouse can be millions of
+// rows once the benchmark's been running a while, and str_arena is a FIXED
+// 128MB reservation whose own overrun guard (str_arena::next's ASSERT)
+// compiles to nothing in a Release build (NDEBUG) - buffering a
+// multi-million-row scan into it silently corrupts unrelated heap memory
+// instead of failing loudly (this was the actual root cause of a hard-to-
+// place SIGSEGV/heap-corruption crash observed during development, well past
+// where any of it looked related to this file). Aggregating directly inside
+// Invoke() instead needs only O(1) memory regardless of table size.
+class ch_q1_scan_callback : public ermia::OrderedIndex::ScanCallback {
+ public:
+  ch_q1_scan_callback(uint32_t delivered_before, ch_q1_group (&groups)[16],
+                      size_t &scanned_tuples)
+      : delivered_before_(delivered_before),
+        groups_(groups),
+        scanned_tuples_(scanned_tuples) {}
+  virtual bool Invoke(const char *keyp, size_t keylen,
+                      const ermia::varstr &value) override {
+    MARK_REFERENCED(keylen);
+    ASSERT(keylen == sizeof(order_line::key));
+    order_line::key k_temp;
+    const order_line::key *k = Decode(keyp, k_temp);
+    order_line::value v_temp;
+    const order_line::value *v = Decode(value, v_temp);
+    if (v->ol_delivery_d == 0 || v->ol_delivery_d > delivered_before_)
+      return true;
+    ch_q1_group &g = groups_[k->ol_number];
+    g.count++;
+    g.sum_qty += v->ol_quantity;
+    g.sum_amount += v->ol_amount;
+    scanned_tuples_++;
+    return true;
+  }
+  uint32_t delivered_before_;
+  ch_q1_group (&groups_)[16];
+  size_t &scanned_tuples_;
+};
+
+static rc_t RunChQ1(ermia::Engine *db, ermia::str_arena &arena,
+                    ermia::transaction *txn_buf,
+                    const std::vector<ermia::OrderedIndex *> &order_line_tables,
+                    uint32_t delivered_before, ch_q1_group (&groups)[16],
+                    size_t &scanned_tuples) {
+  const uint64_t read_only_mask = ermia::config::enable_safesnap
+                                      ? ermia::transaction::TXN_FLAG_READ_ONLY
+                                      : 0;
+  ermia::transaction *txn = db->NewTransaction(read_only_mask, arena, txn_buf);
+
+  ch_q1_scan_callback cb(delivered_before, groups, scanned_tuples);
+  for (uint w = 1; w <= NumWarehouses(); w++) {
+    ermia::scoped_str_arena s_arena(arena);
+    const order_line::key k_lo(w, 0, 0, 0);
+    TryCatch(order_line_tables[w - 1]->Scan(
+        txn, Encode(*arena.next(Size(k_lo)), k_lo), nullptr, cb,
+        s_arena.get()));
+  }
+
+  TryCatch(db->Commit(txn));
+  return {RC_TRUE};
+}
+
+// Streaming aggregation - see ch_q1_scan_callback's doc above for why
+// (unbounded ORDER_LINE scan, fixed-size str_arena, ASSERT compiled out).
+class ch_q6_scan_callback : public ermia::OrderedIndex::ScanCallback {
+ public:
+  ch_q6_scan_callback(uint32_t date_lo, uint32_t date_hi, int32_t max_qty,
+                      double &revenue)
+      : date_lo_(date_lo),
+        date_hi_(date_hi),
+        max_qty_(max_qty),
+        revenue_(revenue) {}
+  virtual bool Invoke(const char *keyp, size_t keylen,
+                      const ermia::varstr &value) override {
+    MARK_REFERENCED(keyp);
+    MARK_REFERENCED(keylen);
+    ASSERT(keylen == sizeof(order_line::key));
+    order_line::value v_temp;
+    const order_line::value *v = Decode(value, v_temp);
+    if (v->ol_delivery_d == 0) return true;
+    if (v->ol_delivery_d < date_lo_ || v->ol_delivery_d >= date_hi_) return true;
+    if (v->ol_quantity >= max_qty_) return true;
+    revenue_ += v->ol_amount;
+    return true;
+  }
+  uint32_t date_lo_, date_hi_;
+  int32_t max_qty_;
+  double &revenue_;
+};
+
+static rc_t RunChQ6(ermia::Engine *db, ermia::str_arena &arena,
+                    ermia::transaction *txn_buf,
+                    const std::vector<ermia::OrderedIndex *> &order_line_tables,
+                    uint32_t date_lo, uint32_t date_hi, int32_t max_qty,
+                    double &revenue) {
+  const uint64_t read_only_mask = ermia::config::enable_safesnap
+                                      ? ermia::transaction::TXN_FLAG_READ_ONLY
+                                      : 0;
+  ermia::transaction *txn = db->NewTransaction(read_only_mask, arena, txn_buf);
+
+  ch_q6_scan_callback cb(date_lo, date_hi, max_qty, revenue);
+  for (uint w = 1; w <= NumWarehouses(); w++) {
+    ermia::scoped_str_arena s_arena(arena);
+    const order_line::key k_lo(w, 0, 0, 0);
+    TryCatch(order_line_tables[w - 1]->Scan(
+        txn, Encode(*arena.next(Size(k_lo)), k_lo), nullptr, cb,
+        s_arena.get()));
+  }
+
+  TryCatch(db->Commit(txn));
+  return {RC_TRUE};
+}

+// Not part of ermia::thread::Runner/the pooled-pthread machinery every
+// tpcc_worker/bench_loader runs on (see dbcore/sm-thread.cpp's IdleTask,
+// which registers RCU/MM once per pooled OS thread at startup) - this is a
+// plain std::thread, so it must register/deregister with RCU and MM itself,
+// mirroring bench_runner::measure_read_view_lsn (the only other raw
+// std::thread in this file that touches the database) exactly.
+void tpcc_bench_runner::HtapThreadMain() {
+  ermia::RCU::rcu_register();
+  ermia::MM::register_thread();
+  ermia::RCU::rcu_start_tls_cache(32, 100000);
+
+  ermia::str_arena arena;
+  ermia::transaction *txn_buf =
+      (ermia::transaction *)malloc(sizeof(ermia::transaction));
+  const std::vector<ermia::OrderedIndex *> &order_line_tables =
+      partitions.at("order_line");
+
+  const auto run_start = std::chrono::steady_clock::now();
+  auto elapsed_secs = [&]() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                         run_start)
+        .count();
+  };
+
+  while (running) {
+    // RunChQ1/RunChQ6's own per-warehouse scoped_str_arena only bounds the SCAN
+    // portion of each call - db->NewTransaction()/db->Commit() also allocate
+    // read-set/commit bookkeeping from this same `arena` outside those inner
+    // scopes, which never gets freed between calls otherwise. str_arena's own
+    // overrun guard (str_arena::next's ASSERT) compiles to nothing in a Release
+    // build (NDEBUG), so left unreset here that bookkeeping would eventually
+    // walk `arena` past its fixed 128MB reservation and silently corrupt
+    // unrelated heap memory instead of failing loudly - reset explicitly every
+    // iteration so nothing outlives one query call.
+    arena.reset();
+
+    ch_q1_group groups[16] = {};
+    size_t scanned_tuples = 0;
+    auto q1_start = std::chrono::steady_clock::now();
+    // Wide open by design - see the CH-benCHmark Q1/Q6 module doc above
+    // RunChQ1/RunChQ6 (ol_delivery_d isn't a real wall-clock timestamp here).
+    rc_t rc = RunChQ1(db, arena, txn_buf, order_line_tables,
+                      std::numeric_limits<uint32_t>::max(), groups,
+                      scanned_tuples);
+    if (!rc.IsAbort()) {
+      auto latency_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            std::chrono::steady_clock::now() - q1_start)
+                            .count();
+      double total_revenue = 0.0;
+      for (auto &g : groups) total_revenue += g.sum_amount;
+      printf("HTAP_SCAN,ch_q1_pricing_summary,%.3f,%zu,%lld,%.2f\n",
+             elapsed_secs(), scanned_tuples, (long long)latency_ns,
+             total_revenue);
+    }
+    if (!running) break;
+    arena.reset();
+
+    double revenue = 0.0;
+    auto q6_start = std::chrono::steady_clock::now();
+    rc = RunChQ6(db, arena, txn_buf, order_line_tables, 0,
+                std::numeric_limits<uint32_t>::max(), 24, revenue);
+    if (!rc.IsAbort()) {
+      auto latency_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            std::chrono::steady_clock::now() - q6_start)
+                            .count();
+      printf("HTAP_SCAN,ch_q6_forecast_revenue,%.3f,%d,%lld,%.2f\n",
+             elapsed_secs(), 1, (long long)latency_ns, revenue);
+    }
+  }
+
+  free(txn_buf);
+  ermia::MM::deregister_thread();
+  ermia::RCU::rcu_deregister();
+}

\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Big-tree leaf sizes show flat throughput (all within $\sim $68K--76K new\_order/s at 64 threads, with/without GC). Scan latency at 64 threads is flat (54--101 µs p50, 89--279 µs p99). Medium remains the default and is optimal across metrics.}}{15}{table.8}\protected@file@percent }
\newlabel{tab:bigtree_sizes}{{8}{15}{Big-tree leaf sizes show flat throughput (all within $\sim $68K--76K new\_order/s at 64 threads, with/without GC). Scan latency at 64 threads is flat (54--101 µs p50, 89--279 µs p99). Medium remains the default and is optimal across metrics}{table.8}{}}

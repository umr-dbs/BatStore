\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Single-field patching nearly doubles YCSB-A throughput by avoiding full-row reconstruction. Using \texttt  {writeallfields=true} recovers old semantics for historical comparisons.}}{16}{table.9}\protected@file@percent }
\newlabel{tab:ycsb_patch}{{9}{16}{Single-field patching nearly doubles YCSB-A throughput by avoiding full-row reconstruction. Using \code {writeallfields=true} recovers old semantics for historical comparisons}{table.9}{}}

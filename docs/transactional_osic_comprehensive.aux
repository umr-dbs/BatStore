\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}WAL and Visibility Path Optimizations}{8}{subsection.3.1}\protected@file@percent }
\newlabel{sec:wal_optimizations}{{3.1}{8}{WAL and Visibility Path Optimizations}{subsection.3.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.1}Optimization 1: Target-CPU Native Code Generation}{8}{subsubsection.3.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.2}Optimization 2: Table-Driven CRC32}{8}{subsubsection.3.1.2}\protected@file@percent }
\newlabel{sec:wal_crc32}{{3.1.2}{8}{Optimization 2: Table-Driven CRC32}{subsubsection.3.1.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces CRC32 table-driven replacement. The write-heavy YCSB-A shows the largest gain because the CRC32 path is directly on every update's critical path. TPC-C gains are smaller because it also includes contention and structural-maintenance costs.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:crc32_impact}{{2}{8}{CRC32 table-driven replacement. The write-heavy YCSB-A shows the largest gain because the CRC32 path is directly on every update's critical path. TPC-C gains are smaller because it also includes contention and structural-maintenance costs}{table.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.3}Optimization 3: Sharded WAL Channels}{8}{subsubsection.3.1.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces WAL sharding reduces producer contention by partitioning the channel. Workers are assigned to shards by \texttt  {worker\_id \% 4}; all shards still write through one shared file and one hardened watermark.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:wal_sharding}{{3}{9}{WAL sharding reduces producer contention by partitioning the channel. Workers are assigned to shards by \code {worker\_id \% 4}; all shards still write through one shared file and one hardened watermark}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Sharded WAL channels show strongest impact on write workloads. Read-only workloads gain little (they do not tax the WAL path). * YCSB-D's gains are treated as unverified; single-trial result with high variance.}}{9}{table.3}\protected@file@percent }
\newlabel{tab:wal_sharding}{{3}{9}{Sharded WAL channels show strongest impact on write workloads. Read-only workloads gain little (they do not tax the WAL path). * YCSB-D's gains are treated as unverified; single-trial result with high variance}{table.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.4}Optimization 4: Removing Flush Tickets}{10}{subsubsection.3.1.4}\protected@file@percent }
\newlabel{sec:wal_tickets}{{3.1.4}{10}{Optimization 4: Removing Flush Tickets}{subsubsection.3.1.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Flush-ticket removal is a pure allocator saving on the write path. Synthetic tests show larger gain because the ticket allocation was the entire per-write cost in that scenario.}}{10}{table.4}\protected@file@percent }
\newlabel{tab:ticket_removal}{{4}{10}{Flush-ticket removal is a pure allocator saving on the write path. Synthetic tests show larger gain because the ticket allocation was the entire per-write cost in that scenario}{table.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.1.5}Optimization 5: Payload-Size Hints for WAL Encoding}{10}{subsubsection.3.1.5}\protected@file@percent }
\newlabel{sec:wal_buffer_size}{{3.1.5}{10}{Optimization 5: Payload-Size Hints for WAL Encoding}{subsubsection.3.1.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Right-sizing WAL buffers eliminates the majority of encoding allocator churn. Gains combine with ticket removal (Optimization~\ref {sec:wal_tickets}) in these numbers.}}{10}{table.5}\protected@file@percent }
\newlabel{tab:buffer_sizing}{{5}{10}{Right-sizing WAL buffers eliminates the majority of encoding allocator churn. Gains combine with ticket removal (Optimization~\ref {sec:wal_tickets}) in these numbers}{table.5}{}}
